# Required to embed and generate answers through Hugging Face Inference.
HF_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
RAG_EMBEDDING_TIMEOUT_SECONDS=45

# Required for the production vector store.
PINECONE_API_KEY=
PINECONE_INDEX=youtube-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=youtube-transcripts

# Optional observability.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=youtube-rag

# Application tuning.
RAG_CHUNK_SIZE=850
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVAL_CANDIDATES=18
RAG_FINAL_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_CHARS=8500
RAG_RERANKER_MODE=lexical
RAG_TRANSCRIPT_CACHE_DIR=.cache/transcripts
RAG_CORS_ORIGINS=http://localhost:3000,chrome-extension://*